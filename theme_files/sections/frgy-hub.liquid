  <style>
    /* Base */
    * { -webkit-font-smoothing: antialiased; }
    html { scroll-behavior: smooth; }
    body { background: #0A0A0A; overflow-x: hidden; }

    /* Scrollbar */
    ::-webkit-scrollbar { width: 6px; }
    ::-webkit-scrollbar-track { background: #0A0A0A; }
    ::-webkit-scrollbar-thumb { background: #9FFF1A; border-radius: 0; }

    /* Selection */
    ::selection { background: #9FFF1A; color: #0A0A0A; }

    /* Grain texture */
    .grain::before {
   content: '';
   position: fixed;
   top: 0; left: 0; width: 100%; height: 100%;
   background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 200 200' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.85' numOctaves='3' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)' opacity='0.15'/%3E%3C/svg%3E");
   pointer-events: none;
   z-index: 9999;
   opacity: 0.08;
   mix-blend-mode: overlay;
    }

    /* Marquee */
    @keyframes marquee {
   0% { transform: translateX(0); }
   100% { transform: translateX(-50%); }
    }
    .marquee-track {
   display: flex;
   animation: marquee 30s linear infinite;
   white-space: nowrap;
    }
    .marquee-track:hover { animation-play-state: paused; }

    /* Scroll reveal */
    .reveal {
   opacity: 0;
   transform: translateY(40px);
   transition: opacity 0.8s cubic-bezier(0.16, 1, 0.3, 1), transform 0.8s cubic-bezier(0.16, 1, 0.3, 1);
    }
    .reveal.active { opacity: 1; transform: translateY(0); }
    .reveal-delay-1 { transition-delay: 0.1s; }
    .reveal-delay-2 { transition-delay: 0.2s; }
    .reveal-delay-3 { transition-delay: 0.3s; }
    .reveal-delay-4 { transition-delay: 0.4s; }

    /* Toad glow */
    @keyframes pulse-glow {
   0%, 100% { filter: drop-shadow(0 0 20px rgba(159, 255, 26, 0.4)) drop-shadow(0 0 60px rgba(159, 255, 26, 0.15)); }
   50% { filter: drop-shadow(0 0 30px rgba(159, 255, 26, 0.6)) drop-shadow(0 0 100px rgba(159, 255, 26, 0.25)); }
    }
    .toad-glow { animation: pulse-glow 4s ease-in-out infinite; }

    /* Product card hover */
    .product-card { transition: transform 0.4s cubic-bezier(0.16, 1, 0.3, 1); }
    .product-card:hover { transform: translateY(-8px); }
    .product-card:hover .product-img { transform: scale(1.05); }
    .product-card:hover .product-overlay { opacity: 1; }
    .product-img { transition: transform 0.6s cubic-bezier(0.16, 1, 0.3, 1); }
    .product-overlay { transition: opacity 0.3s ease; }

    /* Nav blur */
    .nav-scrolled {
   background: rgba(10, 10, 10, 0.85);
   backdrop-filter: blur(20px);
   border-bottom: 1px solid rgba(159, 255, 26, 0.15);
    }

    /* Hero text */
    .hero-title {
   font-size: clamp(3.5rem, 18vw, 20rem);
   line-height: 0.85;
   letter-spacing: -0.02em;
    }

    /* Section heading */
    .section-heading {
   font-size: clamp(2.5rem, 8vw, 7rem);
   line-height: 0.9;
   letter-spacing: -0.01em;
    }

    /* Lifestyle parallax */
    .parallax-bg {
   background-attachment: fixed;
   background-size: cover;
   background-position: center;
    }
    @media (max-width: 768px) {
   .parallax-bg { background-attachment: scroll; }
    }

    /* Drop counter */
    .yield-bar {
   height: 4px;
   background: rgba(159, 255, 26, 0.15);
   border-radius: 2px;
   overflow: hidden;
    }
    .yield-fill {
   height: 100%;
   background: #9FFF1A;
   border-radius: 2px;
   transition: width 1.5s cubic-bezier(0.16, 1, 0.3, 1);
    }

    /* Input focus */
    .drop-input:focus { border-color: #9FFF1A; box-shadow: 0 0 0 3px rgba(159, 255, 26, 0.1); }

    /* Mobile menu */
    .mobile-menu { transform: translateX(100%); transition: transform 0.4s cubic-bezier(0.16, 1, 0.3, 1); }
    .mobile-menu.open { transform: translateX(0); }

    /* Scroll indicator */
    @keyframes scroll-bounce {
   0%, 100% { transform: translateY(0); opacity: 0.3; }
   50% { transform: translateY(8px); opacity: 1; }
    }
    .scroll-indicator { animation: scroll-bounce 2s ease-in-out infinite; }

    /* Wordmark */
    .frogy-wordmark path { fill: currentColor; }

    /* Image fade in */
    .img-fade-in { opacity: 0; transition: opacity 0.6s ease; }
    .img-fade-in.loaded { opacity: 1; }
