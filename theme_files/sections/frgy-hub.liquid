<style id="frgy-hub-reset">
/* ---- Hide Horizon theme chrome (header + footer) ---- */
#header-group,
.shopify-section-group-header-group,
.header-section,
.shopify-section-group-footer-group,
.footer-utilities { display: none !important; }

/* ---- Reset page shell ---- */
html, body { background: #0a0a0a !important; margin: 0 !important; padding: 0 !important; }

#MainContent,
main#MainContent,
#MainContent.content-for-layout {
  display: block !important; width: 100% !important; max-width: none !important;
  margin: 0 !important; padding: 0 !important; grid-template-columns: none !important;
}

[id$="__frgy-hub"] {
  display: block !important; width: 100% !important; max-width: none !important;
  margin: 0 !important; padding: 0 !important;
  grid-template-columns: none !important; grid-column: 1 / -1 !important;
  --page-width: 100%; --page-margin: 0;
}

/* ---- Own grids (renamed to avoid Horizon's .grid collision) ---- */
.frgy-shop-grid {
  display: grid !important;
  grid-template-columns: repeat(1, minmax(0, 1fr)) !important;
  gap: 1.5rem !important;
  width: 100% !important; max-width: none !important;
}
@media (min-width: 640px) {
  .frgy-shop-grid { grid-template-columns: repeat(2, minmax(0, 1fr)) !important; }
}
@media (min-width: 1024px) {
  .frgy-shop-grid { grid-template-columns: repeat(3, minmax(0, 1fr)) !important; gap: 2rem !important; }
}

.frgy-about-grid {
  display: grid !important;
  grid-template-columns: repeat(1, minmax(0, 1fr)) !important;
  gap: 3rem !important; align-items: start !important;
  width: 100% !important; max-width: none !important;
}
@media (min-width: 768px) {
  .frgy-about-grid { grid-template-columns: repeat(2, minmax(0, 1fr)) !important; gap: 5rem !important; }
}

/* ---- Guarantee cards can size themselves ---- */
.frgy-shop-grid > *, .frgy-about-grid > * {
  min-width: 0 !important; width: auto !important; max-width: none !important;
}
.product-card { display: block !important; width: 100% !important; }
[id$="__frgy-hub"] img { max-width: 100% !important; height: auto; }

/* ---- Product card image hover-swap ---- */
.product-card { position: relative; }
.product-card .product-img,
.product-card .product-img-hover {
  transition: opacity 0.4s ease-in-out;
  will-change: opacity;
}
.product-card .product-img-hover {
  position: absolute; inset: 0; opacity: 0;
  width: 100%; height: 100%; object-fit: cover;
}
.product-card:hover .product-img { opacity: 0; }
.product-card:hover .product-img-hover { opacity: 1; }
@media (hover: none) {
  .product-card:hover .product-img { opacity: 1; }
  .product-card:hover .product-img-hover { opacity: 0; }
}

</style>

